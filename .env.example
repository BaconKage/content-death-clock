# Copy to .env and fill in. .env is gitignored — never commit real keys.
# In CI these are supplied as GitHub Actions repository secrets instead.

# https://console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# https://scrapecreators.com -> dashboard -> API key.
SCRAPECREATORS_API_KEY=

# Spare wallets. Credits are PER KEY and non-transferable, so a second key is a
# second 100 credits, not a bigger balance. Add them now rather than later: the
# client rolls over automatically the moment a key is spent, whereas swapping a
# secret by hand means collection stalls until someone notices - and a stalled
# Instagram cohort cannot be resumed, because the posts it was tracking will
# have aged off the profile grid by then.
SCRAPECREATORS_API_KEY_2=
SCRAPECREATORS_API_KEY_3=
