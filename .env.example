# Copy to .env and fill in. .env is gitignored — never commit real keys.
# In CI these are supplied as GitHub Actions repository secrets instead.

# https://console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# https://scrapecreators.com -> dashboard -> API key. Leave blank until the
# free-credit smoke test passes and instagram.enabled is flipped on.
SCRAPECREATORS_API_KEY=
