# secrets — never commit API keys.
# NOTE: a bare `.env` line does NOT match `.env.local`, `.env.dev` etc.
# The glob plus the negation is what actually protects you.
.env*
!.env.example
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# data: silver/gold are derived and rebuildable, bronze is committed by CI
data/silver/
# NOTE: `data/gold/` (with the slash) would exclude the directory itself, and
# git never descends into an excluded directory — so a negation inside it can
# never match. Ignoring the *contents* is what makes the one exception below
# possible. cdc.eval.holdout promises the Cohort B evaluation ledger is a
# committed public record; under the old rule it could never leave the laptop
# that produced it, which quietly voided the guarantee.
data/gold/*
!data/gold/holdout_evaluations.jsonl
data/_bench/
!data/bronze/

# notebooks
.ipynb_checkpoints/

# os
Thumbs.db
.DS_Store
data/bench/
