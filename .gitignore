# secrets — never commit API keys.
# NOTE: a bare `.env` line does NOT match `.env.local`, `.env.dev` etc.
# The glob plus the negation is what actually protects you.
.env*
!.env.example
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# data: silver/gold are derived and rebuildable, bronze is committed by CI
data/silver/
data/gold/
data/_bench/
!data/bronze/

# notebooks
.ipynb_checkpoints/

# os
Thumbs.db
.DS_Store
data/bench/
